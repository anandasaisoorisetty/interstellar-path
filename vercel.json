{
  "version": 2,
  "buildCommand": "npm run build --configuration=production",
  "outputDirectory": "dist/interstellar-path",
  "framework": "angular",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
